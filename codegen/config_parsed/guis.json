        "params": {
          "label": {
            "default": null
          },
          "value": {
            "default": ""
          }
        },
        "objects": {
          "label": {
            "type": "label",
            "name": "label",
            "attrs": {
              "text": "$label",
              "grow": "1"
            },
            "parent_name": "body",
            "is_component": false
          },
          "left": {
            "type": "image",
            "name": "left",
            "attrs": {
              "src": "icons/arrow_left.png",
              "visible": "false"
            },
            "parent_name": "body",
            "is_component": "<ref>"
          },
          "value": {
            "type": "label",
            "name": "value",
            "attrs": {
              "text": "$value",
              "width": "40",
              "align": "right"
            },
            "parent_name": "body",
            "is_component": "<ref>"
          },
          "right": {
            "type": "image",
