<gui>
  <components>

    <!-- SETTINGS ROW COMPONENT -->
    <!-- Row layout: Label | (hidden left arrow) | Value | (hidden right arrow) -->
    <!-- Always hidden arrows; user can choose to show them later in C++ -->
    <SettingRow r-label="" r-value="">
      <body layout="flex" flex-flow="row" height="40">
        <label name="label" v-text="label" flex-grow="1" />
        <image name="left"  src="icons/arrow_left.png" hidden="true"/>
        <label name="value" v-text="value" width="40" align="right" />
        <image name="right" src="icons/arrow_right.png" hidden="true" />
      </body>
    </SettingRow>

    <!-- INFO ROW COMPONENT -->
    <!-- Row layout: Icon | Value | Unit -->
    <!-- Evenly distributed vertically by parent container -->
    <InfoRow r-icon="" r-value="" o-unit="unit" o-hideUnit="false">
      <body layout="flex" flex-flow="row" height="auto">
        <image name="icon" v-src="icon" width="16" height="16" />
        <label name="value" v-text="value" />
        <label name="unit"  v-text="unit" v-hidden="hideUnit" />
      </body>
    </InfoRow>

  </components>

  <root>

    <!-- SCREEN ROOT LAYOUT: 3 columns -->
    <container name="root" layout="flex" flex-flow="col" width="100%" height="100%">

      <!-- LEFT PANE: fills horizontally, scrollable vertically -->
      <container 
        name="leftPane" 
        pad="8" flex-grow="1"
        layout="flex" flex-flow="col" 
        scrollable="true" scroll-dir="x" 
      >
        <SettingRow name="setting-power"     p-label="Power"     p-value="On" />
        <SettingRow name="setting-target"    p-label="Target"    p-value="30.0 °C" />
        <SettingRow name="setting-fan"       p-label="Fan"       p-value="Auto" />
        <SettingRow name="setting-heater"    p-label="Heater"    p-value="Auto" />
        <SettingRow name="setting-calibrate" p-label="Calibrate" p-value="-" />
        <SettingRow name="setting-advanced"  p-label="Advanced"  p-value="-" />
      </container>
      <!-- LEFT PANE END -->

      <!-- MIDDLE PANE: fixed width, rows distributed evenly -->
      <container 
        name="middlePane" 
        pad="8" width="100px"
        layout="flex" flex-flow="col"  
      >
        <label text="Status" height="30" text-color="#cc88ff" />
        <container layout="flex" flex-flow="col" flex-grow="1">
          <InfoRow p-name="status"  p-icon="icons/power16.png"  p-value="Active" />
          <InfoRow p-name="fanPct"  p-icon="icons/fan16.png"    p-value="40.0" p-unit="%" />
          <InfoRow p-name="heatPct" p-icon="icons/heat16.png"   p-value="23.0" p-unit="%" />
        </container>
      </container>
      <!-- MIDDLE PANE END -->

      <!-- RIGHT PANE -->
      <container 
        name="rightPane"
        pad="8" width="100px" 
        layout="flex" flex-flow="col"
      >
        <label text="Sensors" height="30" text-color="#88ccff"/>
        <container layout="flex" flex-flow="col" flex-grow="1">
          <InfoRow name="fanRpm"      p-icon="icons/fan16.png"          p-value="2000" p-unit="RPM" />
          <InfoRow name="temperature" p-icon="icons/temperature16.png"  p-value="28.2" p-unit="°C"  />
          <InfoRow name="humidity"    p-icon="icons/humidity16.png"     p-value="56.3" p-unit="%"   />
          <InfoRow name="power"       p-icon="icons/power16.png"        p-value="15.3" p-unit="W"   />
        </container>
      </container>
      <!-- RIGHT PANE END -->

    </container>
    <!-- SCREEN ROOT LAYOUT END -->

  </root>

</gui>
