      "fields": {
        "fanState": {
          "name": "fanState",
          "type": "FanState",
          "bind": "FanStatus->state",
          "group": "FanStatus",
          "event_type": "FanStatus",
          "event_field": "state"
        },
        "fanMeasuredRpm": {
          "name": "fanMeasuredRpm",
