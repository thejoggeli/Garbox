          "dirty": [
            "MeasuredTemperature",
            "MeasuredHumidity"
          ],
          "group": "SensorStatus",
          "event_type": "TemperatureStatus",
          "event_field": "resetting"
        },
        "shtHasSample": {
          "name": "shtHasSample",
          "type": "bool",
          "bind": "TemperatureStatus->hasFirstSample",
          "dirty": [
            "MeasuredTemperature",
            "MeasuredHumidity"
          ],
          "group": "SensorStatus",
          "event_type": "TemperatureStatus",
          "event_field": "hasFirstSample"
