            "HeatpadMeasure"
          ],
          "group": "HeatpadStatus",
          "event_type": "HeatpadStatus",
          "event_field": "currentDutyCycle"
        },
        "heatpadMeasuredVoltage": {
          "name": "heatpadMeasuredVoltage",
          "type": "float",
