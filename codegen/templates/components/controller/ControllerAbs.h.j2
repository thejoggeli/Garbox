#pragma once
{% include "_common/header.j2" %}
#include "core/application/controller/ControllerAbs.h"
#include "shared/types/EventType.h"
{%- from "_common/includes.j2" import emit_includes -%}
{{- emit_includes(meta) -}}

namespace Garbox {

class {{ name }}Abs : public ControllerAbs {
public:
    
    {{ name }}Abs();

    void receiveTick(TickPhase phase) final {};
    void receiveEvent(const EventHeader* event) final {};
    {# ---- Tick handlers ---- #}
{% if controller.tick_phases %}

    // tick handlers
{% for tick in controller.tick_phases %}
    virtual void on{{ tick }}() = 0;
{% endfor %}
{% endif %}
{# ---- Receive event typedefs + virtual handlers ---- #}
{% if controller.receives %}

    // receive event handlers
{% for ev in controller.receives %}
    virtual void on{{ ev }}(const {{ ev }}Event& event) = 0;
{% endfor %}
{% endif %}

protected:
{% if controller.sends %}

    // make typed events
{% for ev in controller.sends %}
    {{ ev }}Event make{{ ev }}Event();
{% endfor %}

    // send typed events
{% for ev in controller.sends %}
    void sendEvent(const {{ ev }}Event& event);
{% endfor %}
{% endif %}

private:

    // hide event methods
    using ControllerAbs::makeEvent;
    using ControllerAbs::publishEvent;

};

} // namespace Garbox
