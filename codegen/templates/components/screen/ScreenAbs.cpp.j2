{% include "_common/header.j2" %}
{% from "_common/component_cpp.j2" import constructor, make_events, send_events, states %}
#include "{{ name }}Abs.h"
{% if screen.renderer == "lvgl-simple" %}
#include "core/lvgl/LvglProvider.h"
{% endif %}
{% if screen.renderer == "lvgl-gui" %}
#include "core/lvgl/LvglProvider.h"
{% endif %}

namespace Garbox {

{# constructor #}
{{ name }}Abs::{{ name }}Abs(): 
    ScreenAbs(ComponentId::{{ name }}, ScreenId::{{ name.removesuffix("Screen") }})
{%- if screen.renderer == "lvgl-simple" -%},
    mRoot(),
    mScreenWidth(LvglProvider::GetDisplayWidth()),
    mScreenHeight(LvglProvider::GetDisplayHeight())
{%- endif -%}
{%- if screen.renderer == "lvgl-gui" -%},
    mGui(),
    mScreenWidth(LvglProvider::GetDisplayWidth()),
    mScreenHeight(LvglProvider::GetDisplayHeight())
{%- endif -%}
{%- if screen.render_fns -%},
    mRenderDispatcher(static_cast<uint32_t>(RenderFn::Count))
{%- endif -%}{}

{{ make_events(name, screen) }}
{{ send_events(name, screen) }}
{{ states(name, screen) }}

void {{ name }}Abs::init(ComponentHostIfc& host){

{% if screen.renderer == "lvgl-simple" %}
    // init lvgl container
    mRoot.setRawSize(mScreenWidth, mScreenHeight);
    mRoot.setBorder(0, lv_color_hex(0x000000));
    mRoot.setRadius(0);
    mRoot.setPad(0, 0, 0, 0);
    mRoot.setBgOpa(LV_OPA_COVER);
    mRoot.setScrollable(false);
{% endif %}

{% if screen.renderer == "lvgl-gui" %}
    // init gui
    mGui.init();
{% endif %}

{% if screen.render_fns %}
{% for fn_name in screen.render_fns %}
    mRenderDispatcher.registerHandler(render{{ fn_name|upper_first }}Trampoline, this);
{% endfor %}
{% endif %}

    // calls onInit()
    ScreenAbs::init(host);
}

void {{ name }}Abs::render(){
    ScreenAbs::render();
{% if screen.render_fns %}
    mDispatchedCount += mRenderDispatcher.getDirtyCount();
    mRenderDispatcher.dispatch();
{% endif %}
}

void {{ name }}Abs::becomeEnabled(){
{% if screen.renderer == "lvgl-simple" %}
    mRoot.setScreen();
{% endif %}
{% if screen.renderer == "lvgl-gui" %}
    mGui.show();
{% endif %}

{% if screen.render_fns %}
    // mark all render functions dirty for complete redraw 
{% for fn_name in screen.render_fns %}
    markDirty(RenderFn::{{ fn_name|upper_first }});
{% endfor %}
{% endif %}

    ScreenAbs::becomeEnabled();
}

void {{ name }}Abs::becomeDisabled(){
    ScreenAbs::becomeDisabled();
}

{### <LvglSimple> ###}
{% if screen.renderer == "lvgl-simple" %}
void {{ name }}Abs::setBackgroundColor(uint32_t color){
    mRoot.setBgColor(lv_color_hex(color));
}
{% endif %}
{### </LvglSimple> ###}

{### <LvglGui> ###}
{% if screen.renderer == "lvgl-gui" %}
{{ screen.gui["name"] }}Gui::Objects& {{ name }}Abs::gui(){
    return mGui.objects();
}

void {{ name }}Abs::setBackgroundColor(uint32_t color){
    mGui.objects().root.setBgColor(lv_color_hex(color));
}
{% endif %}
{### </LvglGui> ###}

{### <RenderFunctions> ###}
{% if screen.render_fns %}

void {{ name }}Abs::markDirty(RenderFn fn){
    mRenderDispatcher.markDirty(static_cast<size_t>(fn));
}

bool {{ name }}Abs::isMarkedDirty(RenderFn fn) const {
    return mRenderDispatcher.isMarkedDirty(static_cast<size_t>(fn));
}

{% for fn_name in screen.render_fns %}
void {{ name }}Abs::render{{ fn_name|upper_first }}Trampoline(void* context){
    static_cast<{{ name }}Abs*>(context)->onRender{{ fn_name|upper_first }}();
}

{% endfor %}
{% endif %}
{### </RenderFunctions> ###}

} // namespace Garbox
