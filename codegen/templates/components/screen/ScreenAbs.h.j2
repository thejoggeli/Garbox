#pragma once
{% include "_common/header.j2" %}
{% set ScreenName = name ~ 'Abs' %}
#include "core/application/screen/ScreenAbs.h"

namespace Garbox {

class {{ ScreenName }} : public ScreenAbs {
public:

    {{ ScreenName }}();

    void receiveTick(TickPhase phase) final {};
    void receiveEvent(const EventHeader* event) final {};
{# ---- Tick handlers ---- #}
{% if screen.tick_phases %}

    // tick handlers
    {% for tick in screen.tick_phases %}
    virtual void on{{ tick }}() = 0;
    {% endfor %}
{% endif %}
{# ---- receives ---- #}
{% if screen.receives %}

    {# onEvent methods #}
    // receive event handlers
    {% for ev in screen.receives %}
    virtual void on{{ ev }}(const {{ ev }}Event& event) = 0;
    {% endfor %}
{% endif %}

protected:
{# send event methods #}
{% if screen.sends %}

    {# makeEvent methods #}
    // make typed events
    {% for ev in screen.sends %}
    {{ ev }}Event make{{ ev }}Event();
    {% endfor %}

    {# sendEvent methods #}
    // send typed events
    {% for ev in screen.sends %}
    void sendEvent(const {{ ev }}Event& event);
    {% endfor %}
{% endif %}

private:

    // hide event methods
    using ScreenAbs::makeEvent;
    using ScreenAbs::publishEvent;

};

} // namespace Garbox
