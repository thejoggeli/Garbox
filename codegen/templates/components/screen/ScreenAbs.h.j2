#pragma once
{% include "_common/header.j2" %}
{% from "_common/component_h.j2" import constructor, on_ticks, on_events, make_events, send_events, hide_events %}
{% if screen.use_gui %}
#include "app/guis/{{ screen.gui["name"] }}Gui.h"
{% endif %}
#include "core/application/screen/ScreenAbs.h"
{% if screen.use_lvgl %}
#include "core/lvgl/objects/LvObject.h"
{% endif %}
{% if screen.model.get("debounce") %}
#include "core/time/SoftwareTimer.h"
{% endif %}
#include "shared/types/EventType.h"

namespace Garbox {

class {{ name }}Abs : public ScreenAbs {
public:

    // constructor 
    {{name}}Abs();

    // init override from component
    void init(ComponentHostIfc& host) final;
    void updateScreen() final;
    void becomeEnabled() final;
    void becomeDisabled() final;

{# onTick() #}
{{ on_ticks(screen) }}

{# onEvent() #}
{{ on_events(screen) }}

protected:

{# onApplyX() handlers for model #}
{% if screen.use_model %}
    // model field callbacks to update specific parts of the screen (to be implmeneted by user)
{% for group_name, fields in screen.model.groups.items() %}
    virtual void onApply{{ group_name|upper_first }}() = 0;
{% endfor %}
{% endif %}

{# make and send events #}
{{ make_events(screen) }}
{{ send_events(screen) }}

private:

{# hide events #}
{{ hide_events("Screen") }}

{% if screen.use_lvgl %}
{####################}
{### LVGL Section ###}
{####################}

/********************/
/*** LVGL Section ***/
/********************/

protected:

    LvObject mRoot;
    const uint32_t mScreenWidth = 0;
    const uint32_t mScreenHeight = 0;

    void setBackgroundColor(uint32_t color);
{% endif %}

{% if screen.use_gui %}
{###################}
{### GUI Section ###}
{###################}

/*******************/
/*** GUI Section ***/
/*******************/

private:

    {{ screen.gui["name"] }}Gui mGui;

protected:

    {{ screen.gui["name"] }}Gui::Objects& gui(); 
    const uint32_t mScreenWidth = 0;
    const uint32_t mScreenHeight = 0;

    void setBackgroundColor(uint32_t color);
{% endif %}

{% if screen.use_model %}
{#####################}
{### Model Section ###}
{#####################}

/*********************/
/*** Model Section ***/
/*********************/

public: 

{% set block %}
    {% include "components/screen/ScreenModel.h.j2" %}
{% endset %}
{{ block | indent(4, true) }}

private:

    // model instance
    Model mModel;

public:

    Model& model();
    const Model& model() const;

protected: 

    // dispatcher (calls apply methods)
    DirtyDispatcher mDirtyDispatcher;
    uint32_t mDispatchedCount = 0;
    uint32_t getDispatchedCount() const { return mDispatchedCount; }

    // method to mark an model field index dirty (for manually updated values)
    void markDirty(Model::Index index);
    bool isMarkedDirty(Model::Index index) const;

private: 

{% for event_type, event_data in screen.model.events.items() %}
    void setSnapshot{{ event_type }}();
{% endfor %}

{# model field apply trampolines #}
    // model field apply trampolines
{% for name in screen.model.groups.keys() %}
    static void apply{{ name|upper_first }}Trampoline(void* context);
{% endfor %}

{% endif %}

};

} // namespace Garbox
