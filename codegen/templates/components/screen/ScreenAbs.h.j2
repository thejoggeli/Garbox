#pragma once
{% include "_common/header.j2" %}
{% from "_common/component_h.j2" import comp_includes, constructor %}
{% from "_common/component_h.j2" import on_ticks, on_events, on_states_changed %}
{% from "_common/component_h.j2" import make_events, send_events, hide_events %}
{% from "_common/component_h.j2" import states_protected, states_private %}

#include "core/application/screen/ScreenAbs.h"
{% if screen.renderer == "lvgl-simple" %}
#include "core/lvgl/objects/LvObject.h"
{% endif %}
{% if screen.renderer == "lvgl-gui" %}
#include "generated/guis/{{ screen.gui["name"] }}Gui.h"
{% endif %}
{{ comp_includes(screen) }}

namespace Garbox {

class {{ runtime_name }};

class {{ name }}Abs : public ScreenAbs {
public:

{{ constructor(name) }}
{{ on_ticks(screen) }}

{% if screen.render_fns %}
    // render functions (to be implmeneted by user)
{% for fn_name in screen.render_fns %}
    virtual void onRender{{ fn_name|upper_first }}() = 0;
{% endfor %}
{% endif %}

{{ on_events(screen) }}
{{ on_states_changed(screen) }}

protected:

{{ make_events(screen) }}
{{ send_events(screen) }}
{{ states_protected(screen) }}
private:
{{ states_private(screen) }}
{{ hide_events("Screen") }}

    friend class {{ runtime_name }};

public:

    // init override from component
    void init(ComponentHostIfc& host) final;
    void render() final;
    void becomeEnabled() final;
    void becomeDisabled() final;

{### <LvglSimple> ###}
{% if screen.renderer == "lvgl-simple" %}
protected:

    LvObject mRoot;
    const uint32_t mScreenWidth = 0;
    const uint32_t mScreenHeight = 0;

    void setBackgroundColor(uint32_t color);
{% endif %}
{### </LvglSimple> ###}

{### <LvglGui> ###}
{% if screen.renderer == "lvgl-gui" %}
private:

    {{ screen.gui["name"] }}Gui mGui;

protected:

    {{ screen.gui["name"] }}Gui::Objects& gui(); 
    const uint32_t mScreenWidth = 0;
    const uint32_t mScreenHeight = 0;

    void setBackgroundColor(uint32_t color);
{% endif %}
{### </LvglGui> ###}

{### <RenderFunctions> ###}
{% if screen.render_fns %}
protected: 

    // render function indices 
    enum class RenderFn : uint8_t { 
{% for fn_name in screen.render_fns %}
        {{ fn_name }}{% if loop.first %} = 0{% endif %},
{% endfor %}
        Count 
    }; 

    // render dispatcher (calls render methods)
    DirtyDispatcher mRenderDispatcher;
    uint32_t mDispatchedCount = 0;
    uint32_t getDispatchedCount() const { return mDispatchedCount; }

    // method to mark a render function dirty
    void markDirty(RenderFn fn);
    bool isMarkedDirty(RenderFn fn) const;

private: 

    // render trampolines
{% for fn_name in screen.render_fns %}
    static void render{{ fn_name|upper_first }}Trampoline(void* context);
{% endfor %}

{% endif %}
{### </RenderFunctions> ###}

};

} // namespace Garbox
