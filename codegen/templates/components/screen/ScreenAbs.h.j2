#pragma once
{% include "_common/header.j2" %}
{% from "_common/component_h.j2" import constructor, on_ticks, on_events, make_events, send_events, hide_events %}
#include "core/application/screen/ScreenAbs.h"
{% if screen.model.get("debounce") %}
#include "core/time/SoftwareTimer.h"
{% endif %}
#include "shared/types/EventType.h"

namespace Garbox {

class {{ name }}Abs : public ScreenAbs {
protected:

{# update user handlers #}
{% if screen.model.fields %}
    // model field callbacks to update specific parts of the screen (to be implmeneted by user)
{% for group_name, fields in screen.model.groups.items() %}
    virtual void onApply{{ group_name|upper_first }}() = 0;
{% endfor %}
{% endif %}

public:

{# onTick() #}
{{ on_ticks(screen) }}

{# onEvent() #}
{{ on_events(screen) }}

{# constructor #}
{{ constructor(name) }}

    void init(ComponentHostIfc& host) final;

{% if screen.model.get("debounce") %}
    void updateScreen() final;
    void becomeEnabled() final;
    void becomeDisabled() final;
{% endif %}

{% set block %}
    {% include "components/screen/ScreenModel.h.j2" %}
{% endset %}
{{ block | indent(4, true) }}

    Model& getModel();
    const Model& getModel() const;

protected:

    Model mModel;

{# markDirty() #}
    // method to mark an model field index dirty (for manually updated values)
    void markDirty(Model::Index index);
    bool isMarkedDirty(Model::Index index) const;


{# make and send events #}
{{ make_events(screen) }}
{{ send_events(screen) }}

private:

{# model field apply trampolines #}
{% if screen.model.fields %}
    // model field apply trampolines
{% for name in screen.model.groups.keys() %}
    static void apply{{ name|upper_first }}Trampoline(void* context);
{% endfor %}
{% endif %}

{# hide events #}
{{ hide_events("Screen") }}

    // hide dangerous raw access
    using ScreenAbs::registerUpdateHandler;
    using ScreenAbs::markDirtyRaw;
    using ScreenAbs::isMarkedDirtyRaw;

};

} // namespace Garbox
