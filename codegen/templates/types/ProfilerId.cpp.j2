{% include "_common/header.j2" %}
#include "ProfilerId.h"
{%- from "_common/includes.j2" import emit_includes -%}
{{- emit_includes(includes) -}}

namespace Garbox {

const char* ProfilerIdToString(ProfilerId id){
    switch(id){
        case ProfilerId::Null: return "Null";
{% for name in all_ids %}
        case ProfilerId::{{ name }}: return "{{ name }}";
{% endfor %}
        case ProfilerId::Count: return "Count";
    }
    return "Invalid";
}

} // namespace Garbox
