{# constructor #}
{% macro constructor(type, name, component) %}
{{ name }}Abs::{{ name }}Abs() : {{ type }}Abs(ComponentId::{{ name }}, {{ type }}Id::{{ name.removesuffix(type) }}){
    // nothing to do
}
{% endmacro %}


{# make events #}
{% macro make_events(name, component) %}
{% if component.send_events %}
{% for ev in component.send_events %}
{{ ev }}Event {{ name }}Abs::make{{ ev }}Event(){
    return ComponentAbs::makeEvent<EventType::{{ ev }}>();
}

{% endfor %}
{% endif %}
{% endmacro %}


{# send events #}
{% macro send_events(name, component) %}
{% if component.send_events %}
{% for ev in component.send_events %}
void {{ name }}Abs::sendEvent(const {{ ev }}Event& event){
    sendEventToHost(event.header());
}

{% endfor %}
{% endif %}
{% endmacro %}

{# states #}
{% macro states(name, component) %}

{% if component.all_states %}

{{ name }}Abs::States& {{ name }}Abs::states(){
    return mStates.value();
}

void {{ name }}Abs::bindStates(
{% for state_name, state_data in component.write_states.items() %}
    {% set delim = "" if loop.last and not component.read_states else ","%}
    {{ state_data["name_with_suffix"]|upper_first }}& {{ state_data["name"]|lower_first }}{{ delim }}
{% endfor %}
{% for state_name, state_data in component.read_states.items() %}
    {% set delim = "" if loop.last else ","%}
    const {{ state_data["name_with_suffix"]|upper_first }}& {{ state_data["name"]|lower_first }}{{ delim }}
{% endfor %}
){
    mStates.emplace(
    {% for state_name, state_data in component.write_states.items() %}
        {% set delim = "" if loop.last and not component.read_states else ","%}
        {{ state_data["name"]|lower_first }}{{ delim }}
    {% endfor %}
    {% for state_name, state_data in component.read_states.items() %}
        {% set delim = "" if loop.last else ","%}
        {{ state_data["name"]|lower_first }}{{ delim }}
    {% endfor %}
    );
}

{% endif %}
{% endmacro %}
