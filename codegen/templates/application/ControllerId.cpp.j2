{% include "_common/header.j2" %}

#include "ControllerId.h"

{%- from "_common/includes.j2" import emit_includes -%}
{{- emit_includes(includes) -}}

namespace Garbox {

const char* ControllerIdToString(ControllerId id){
    switch(id){
        case ControllerId::Null: return "Null";
{% for name in names %}
        case ControllerId::{{ name.removesuffix("Controller") }}: return "{{ name.removesuffix("Controller") }}";
{% endfor %}
        case ControllerId::Count: return "Count";
    }
    return "Invalid";
}

} // namespace Garbox
