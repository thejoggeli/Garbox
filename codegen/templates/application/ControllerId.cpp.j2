{% include "_common/header.j2" %}

#include "BehaviourId.h"

{%- from "_common/includes.j2" import emit_includes -%}
{{ emit_includes(includes) }}

namespace Garbox {

const char* BehaviourIdToString(BehaviourId id){
    switch(id){
        case BehaviourId::Null: return "Null";
{% for name in names %}
        case BehaviourId::{{ name }}: return "{{ name }}";
{% endfor %}
        case BehaviourId::Count: return "Count";
    }
    return "Invalid";
}

} // namespace Garbox
