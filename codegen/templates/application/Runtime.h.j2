#pragma once
{% include "_common/header.j2" %}
{% set RuntimeName = setup.name ~ 'Runtime' %}
#include "core/application/runtime/RuntimeAbs.h"
#include "core/application/runtime/TickRunner.h"
{# include all behaviour headers #}
{% for path in behaviour_paths | sort %}
#include "{{ path }}.h"
{% endfor %}
{# include all controller headers #}
{% for path in controller_paths | sort %}
#include "{{ path }}.h"
{% endfor %}

namespace Garbox {

class {{ RuntimeName }} : public RuntimeAbs {
public:

    {{ RuntimeName }}(const RuntimeAbs::Config& config);

private:

    TickRunner mTickRunner;

    {# behaviour instances #}
    {% for beh in behaviours %}
    {{ beh }} m{{ beh }};
    {% endfor %}

    {# controller instances #}
    {% for ctrl in controllers %}
    {{ ctrl }} m{{ ctrl }};
    {% endfor %}

    void handleTickStart();
    void handleTickEnd();

    {# Generate tick method declarations #}
    {% for tick in setup.tick_phases %}
    void handle{{ tick.name }}();
    {% endfor %}

    void onInit() final;
    void onStart() final;
    void onRun() final;
    void onRouteEvent(const EventHeader* header) final;
    void onRegister() final;

    ControllerAbs* resolveController(ControllerId id) final;
    BehaviourAbs* resolveBehaviour(BehaviourId id) final;
    
};

} // namespace Garbox
