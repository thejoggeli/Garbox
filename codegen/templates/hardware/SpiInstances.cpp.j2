{% include "_common/header.j2" %}
#include "SpiInstances.h"
#include "core/assert/Assert.h"
{%- from "_common/includes.j2" import emit_includes -%}
{{- emit_includes(meta) -}}

namespace Garbox {

static bool sInitialized = false;

void SpiInstances::Init(){
    
    AssertExit(!sInitialized, "SpiInstances", "already initialized");

{% for name, entry in spi.items() %}
    Get{{ name }}().init({
        .hostDevice = {{ entry.hostDevice }},
        .pinMosi = PinMosi{{ name }},
        .pinMiso = PinMiso{{ name }},
        .pinClk = PinClk{{ name }},
        .pinCs = PinCs{{ name }},
        .mode = {{ entry.mode }},
        .frequencyHz = {{ entry.frequencyHz }},
        .maxTransferSizeBytes = {{ entry.maxTransferSizeBytes }},
        .queueSize = {{ entry.queueSize }},
    });
{% endfor %}

    sInitialized = true;
}

{% for name, entry in spi.items() %}
SpiDma& SpiInstances::Get{{ name }}(){
    static SpiDma instance;
    return instance;
}
{% endfor %}

} // namespace
