<gui>

  <resources>

      <!-- fonts are not implemented yet -->
    <font name="my-very-special-font" />

    <image name="power-16px"       path="icons/power.png"        resize="16x16" format="RGB565A8" />
    <image name="fan-16px"         path="icons/fan.png"          resize="16x16" format="RGB565A8" />
    <image name="heat-16px"        path="icons/heat.png"         resize="16x16" format="RGB565A8" />
    <image name="humidity-16px"    path="icons/humidity.png"     resize="16x16" format="RGB565A8" />
    <image name="temperature-16px" path="icons/temperature.png"  resize="16x16" format="RGB565A8" />

  </resources>

  <components>

    <!-- SETTINGS ROW COMPONENT -->
    <!-- Row layout: Label | (hidden left arrow) | Value | (hidden right arrow) -->
    <!-- Always hidden arrows; user can choose to show them later in C++ -->
    <SettingRow $label $value>
      <body layout="flex" flex-flow="row" height="40">
        <label name="label" text=$label flex-grow="1" />
        <label name="left"  text="&lt;" width="10px" hidden="true" />
        <label name="value" text=$value width="40px" align="right" />
        <label name="right" text="&gt;" width="10px" hidden="true" />
      </body>
    </SettingRow>

    <!-- INFO ROW COMPONENT -->
    <!-- Row layout: Icon | Value | Unit -->
    <!-- Evenly distributed vertically by parent container -->
    <InfoRow $icon $value $unit="unit" $hideUnit="false">
      <body layout="flex" flex-flow="row" height="auto">
        <image name="icon"  src=$icon width="16" height="16" />
        <label name="value" text=$value />
        <label name="unit"  text=$unit hidden=$hideUnit />
      </body>
    </InfoRow>

  </components>

  <root>

    <!-- SCREEN ROOT LAYOUT: 3 columns -->
    <container name="wrapper" >

      <!-- LEFT PANE: fills horizontally, scrollable vertically -->
      <container 
        name="leftPane" 
        pad="8" flex-grow="1"
        layout="flex" flex-flow="col" 
        scrollable="true" scroll-dir="x" 
      >
        <SettingRow name="settingPower"       $label="Power"      $value="On" />
        <SettingRow name="settingTarget"      $label="Target"     $value="30.0 °C" />
        <SettingRow name="settingFan"         $label="Fan"        $value="auto" />
        <SettingRow name="settingHeater"      $label="Heater"     $value="auto" />
        <SettingRow name="settingBrightness"  $label="Brightness" $value="-" />
        <SettingRow name="settingCalibrate"   $label="Calibrate"  $value="-" />
        <SettingRow name="settingAdvanced"    $label="Advanced"   $value="-" />
      </container>
      <!-- LEFT PANE END -->

      <!-- MIDDLE PANE: fixed width, rows distributed evenly -->
      <container 
        name="middlePane" 
        pad="8" width="100px"
        layout="flex" flex-flow="col"  
      >
        <label text="Status" height="30" text-color="#cc88ff" />
        <container layout="flex" flex-flow="col" flex-grow="1">
          <InfoRow name="statusEngine"      $icon="power-16px"        $value="" $hideUnit="true" />
          <InfoRow name="statusTemperature" $icon="temperature-16px"  $value="" $unit="°C" />
          <InfoRow name="statusFan"         $icon="fan-16px"          $value="" $unit="%" />
          <InfoRow name="statusHeat"        $icon="heat-16px"         $value="" $unit="%" />
        </container>
      </container>
      <!-- MIDDLE PANE END -->

      <!-- RIGHT PANE -->
      <container 
        name="rightPane"
        pad="8" width="100px" 
        layout="flex" flex-flow="col"
      >
        <label text="Sensors" height="30" text-color="#88ccff"/>
        <container layout="flex" flex-flow="col" flex-grow="1">
          <InfoRow name="sensorPower"       $icon="power-16px"        $value="" $unit="W"   />
          <InfoRow name="sensorTemperature" $icon="temperature-16px"  $value="" $unit="°C"  />
          <InfoRow name="sensorFan"         $icon="fan-16px"          $value="" $unit="RPM" />
          <InfoRow name="sensorHumidity"    $icon="humidity-16px"     $value="" $unit="%"   />
        </container>
      </container>
      <!-- RIGHT PANE END -->

    </container>
    <!-- SCREEN ROOT LAYOUT END -->

  </root>

</gui>
