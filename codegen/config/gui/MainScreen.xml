<gui>
  <components>

    <!-- SETTINGS ROW COMPONENT -->
    <!-- Row layout: Label | (hidden left arrow) | Value | (hidden right arrow) -->
    <!-- Always hidden arrows; user can choose to show them later in C++ -->
    <SettingRow>
      <param name="label" />
      <param name="value" default="" />
      <body layout="flex-row" height="40">
        <label  name="label" text="$label" grow="1" />
        <image  name="left"  src="icons/arrow_left.png"  visible="false" />
        <label  name="value" text="$value" width="40" align="right" />
        <image  name="right" src="icons/arrow_right.png" visible="false" />
      </body>
    </SettingRow>

    <!-- INFO ROW COMPONENT -->
    <!-- Row layout: Icon | Value | Unit -->
    <!-- Evenly distributed vertically by parent container -->
    <InfoRow>
      <param name="icon"/>
      <param name="value"/>
      <param name="unit" default="" />
      <param name="showUnit" default="false" />
      <body layout="flex-row" height="auto">
        <image name="icon" src="$icon" width="16" height="16" />
        <label name="value" text="$value" />
        <label name="unit"  text="$unit" visible="$showUnit" />
      </body>
    </InfoRow>

  </components>

  <body>

    <!-- SCREEN ROOT LAYOUT: 3 columns -->
    <container name="root" layout="grid" grid-columns="1fr 120px 120px" grid-rows="1fr" width="100%" height="100%">

      <!-- LEFT PANE: fills horizontally, scrollable vertically -->
      <container name="leftPane" grid-column="1" layout="flex-col" scroll-y="true" padding="8">
        <SettingRow name="setting-power"     label="Power"     value="On" />
        <SettingRow name="setting-target"    label="Target"    value="30.0 °C" />
        <SettingRow name="setting-fan"       label="Fan"       value="Auto" />
        <SettingRow name="setting-heater"    label="Heater"    value="Auto" />
        <SettingRow name="setting-calibrate" label="Calibrate" />
        <SettingRow name="setting-advanced"  label="Advanced"  />
      </container>
      <!-- LEFT PANE END -->

      <!-- MIDDLE PANE: fixed width, rows distributed evenly -->
      <container name="middlePane" grid-column="2" layout="flex-col" width="120px" padding="8">
        <label text="Status" bold="true" height="30" />
        <container layout="flex-col" grow="1">
          <InfoRow name="status"  icon="icons/power16.png"  value="Active" />
          <InfoRow name="fanPct"  icon="icons/fan16.png"    value="40.0" unit="%" showUnit="true" />
          <InfoRow name="heatPct" icon="icons/heat16.png"   value="23.0" unit="%" showUnit="true" />
        </container>
      </container>
      <!-- MIDDLE PANE END -->

      <!-- RIGHT PANE -->
      <container name="rightPane" grid-column="3" layout="flex-col" width="120px" padding="8">
        <label text="Sensors" bold="true" height="30" />
        <container layout="flex-col" grow="1">
          <InfoRow name="fanRpm"      icon="icons/fan16.png"          value="2000" unit="RPM" showUnit="true" />
          <InfoRow name="temperature" icon="icons/temperature16.png"  value="28.2" unit="°C"  showUnit="true" />
          <InfoRow name="humidity"    icon="icons/humidity16.png"     value="56.3" unit="%"   showUnit="true" />
          <InfoRow name="power"       icon="icons/power16.png"        value="15.3" unit="W"   showUnit="true" />
        </container>
      </container>
      <!-- RIGHT PANE END -->

    </container>
    <!-- SCREEN ROOT LAYOUT END -->

  </body>

</gui>
