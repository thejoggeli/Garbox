<gui>
  <components>

    <!-- SETTINGS ROW COMPONENT -->
    <!-- Row layout: Label | (hidden left arrow) | Value | (hidden right arrow) -->
    <!-- Always hidden arrows; user can choose to show them later in C++ -->
    <SettingRow $label $value>
      <body layout="flex" flex-flow="row" height="40">
        <label name="label" text=$label flex-grow="1" />
        <image name="left"  src="icons/arrow_left.png" hidden="true"/>
        <label name="value" text=$value width="40" align="right" />
        <image name="right" src="icons/arrow_right.png" hidden="true" />
      </body>
    </SettingRow>

    <!-- INFO ROW COMPONENT -->
    <!-- Row layout: Icon | Value | Unit -->
    <!-- Evenly distributed vertically by parent container -->
    <InfoRow $icon $value $unit="unit" $hideUnit="false">
      <body layout="flex" flex-flow="row" height="auto">
        <image name="icon" src=$icon width="16" height="16" />
        <label name="value" text=$value />
        <label name="unit"  text=$unit hidden=$hideUnit />
      </body>
    </InfoRow>

  </components>

  <root>

    <!-- SCREEN ROOT LAYOUT: 3 columns -->
    <container name="root" layout="flex" flex-flow="col" width="100%" height="100%">

      <!-- LEFT PANE: fills horizontally, scrollable vertically -->
      <container 
        name="leftPane" 
        pad="8" flex-grow="1"
        layout="flex" flex-flow="col" 
        scrollable="true" scroll-dir="x" 
      >
        <SettingRow name="setting-power"     $label="Power"     $value="On" />
        <SettingRow name="setting-target"    $label="Target"    $value="30.0 °C" />
        <SettingRow name="setting-fan"       $label="Fan"       $value="Auto" />
        <SettingRow name="setting-heater"    $label="Heater"    $value="Auto" />
        <SettingRow name="setting-calibrate" $label="Calibrate" $value="-" />
        <SettingRow name="setting-advanced"  $label="Advanced"  $value="-" />
      </container>
      <!-- LEFT PANE END -->

      <!-- MIDDLE PANE: fixed width, rows distributed evenly -->
      <container 
        name="middlePane" 
        pad="8" width="100px"
        layout="flex" flex-flow="col"  
      >
        <label text="Status" height="30" text-color="#cc88ff" />
        <container layout="flex" flex-flow="col" flex-grow="1">
          <InfoRow $name="status"  $icon="icons/power16.png"  $value="Active" />
          <InfoRow $name="fanPct"  $icon="icons/fan16.png"    $value="40.0" $unit="%" />
          <InfoRow $name="heatPct" $icon="icons/heat16.png"   $value="23.0" $unit="%" />
        </container>
      </container>
      <!-- MIDDLE PANE END -->

      <!-- RIGHT PANE -->
      <container 
        name="rightPane"
        pad="8" width="100px" 
        layout="flex" flex-flow="col"
      >
        <label text="Sensors" height="30" text-color="#88ccff"/>
        <container layout="flex" flex-flow="col" flex-grow="1">
          <InfoRow name="fanRpm"      $icon="icons/fan16.png"          $value="2000" $unit="RPM" />
          <InfoRow name="temperature" $icon="icons/temperature16.png"  $value="28.2" $unit="°C"  />
          <InfoRow name="humidity"    $icon="icons/humidity16.png"     $value="56.3" $unit="%"   />
          <InfoRow name="power"       $icon="icons/power16.png"        $value="15.3" $unit="W"   />
        </container>
      </container>
      <!-- RIGHT PANE END -->

    </container>
    <!-- SCREEN ROOT LAYOUT END -->

  </root>

</gui>
