<gui>

  <resources>

      <!-- fonts are not implemented yet -->
    <font name="my-very-special-font" />

    <image name="power-16px"       path="icons/power.png"        resize="16x16" format="RGB565A8" />
    <image name="fan-16px"         path="icons/fan.png"          resize="16x16" format="RGB565A8" />
    <image name="heat-16px"        path="icons/heat.png"         resize="16x16" format="RGB565A8" />
    <image name="humidity-16px"    path="icons/humidity.png"     resize="16x16" format="RGB565A8" />
    <image name="temperature-16px" path="icons/temperature.png"  resize="16x16" format="RGB565A8" />

  </resources>

  <components>

    <!-- SETTINGS ROW COMPONENT -->
    <!-- Row layout: Label | (hidden left arrow) | Value | (hidden right arrow) -->
    <!-- Always hidden arrows; user can choose to show them later in C++ -->
    <SettingRow $label $value>
      <body layout="flex" flex-flow="row" width="content" height="content">
        <label name="label" text=$label text-align="left"   width="content" />
        <label name="value" text=$value text-align="center" width="content" />
      </body>
    </SettingRow>

    <!-- INFO ROW COMPONENT -->
    <!-- Row layout: Icon | Value | Unit -->
    <!-- Evenly distributed vertically by parent container -->
    <InfoRow $icon $value $unit="unit" $hideUnit="false">
      <body layout="flex" flex-flow="row" height="content">
        <image name="icon"  src=$icon width="16" height="16" />
        <label name="value" text=$value pad-left="4px" pad-right="4px" />
        <label name="unit"  text=$unit hidden=$hideUnit text-align="right" flex-grow="1" />
      </body>
    </InfoRow>

  </components>

  <root bg-color="#000000" text-color="#ffffff">

    <container layout="flex" flex-flow="row" width="100%" height="100%" bg-color="#cccccc" bg-opacity="100%">

      <container layout="flex" flex-flow="column" flex-align="start start start" flex-grow="1" height="100%" pad="4px" pad-gap="4px">
        <SettingRow name="settingPower"       $label="Power"      bg-color="#880088" bg-opacity="100%" $value="On" />
        <SettingRow name="settingTarget"      $label="Target"     bg-color="#008888" bg-opacity="100%" $value="30.0°C" />
        <SettingRow name="settingFan"         $label="Fan"        bg-color="#880000" bg-opacity="100%" $value="auto" />
        <SettingRow name="settingHeater"      $label="Heater"     bg-color="#000088" bg-opacity="100%" $value="auto" />
        <SettingRow name="settingBrightness"  $label="Brightness" bg-color="#008800" bg-opacity="100%" $value="-" />
        <SettingRow name="settingCalibrate"   $label="Calibrate"  bg-color="#888800" bg-opacity="100%" $value="-" />
        <SettingRow name="settingAdvanced"    $label="Advanced"   bg-color="#880088" bg-opacity="100%" $value="-" />
      </container>

      <container layout="flex" flex-flow="column" flex-align="start start start" width="100px" height="100%" bg-color="#444444" bg-opacity="100%" pad="4px" pad-gap="8px">
        <InfoRow name="statusEngine"      $icon="power-16px"        $value="" $hideUnit="true" />
        <InfoRow name="statusTemperature" $icon="temperature-16px"  $value="" $unit="°C" />
        <InfoRow name="statusFan"         $icon="fan-16px"          $value="" $unit="%" />
        <InfoRow name="statusHeat"        $icon="heat-16px"         $value="" $unit="%" />
      </container>

      <container layout="flex" flex-flow="column" flex-align="start start start" width="100px" height="100%" bg-color="#440000" bg-opacity="100%" pad="4px" pad-gap="8px">
          <InfoRow name="sensorPower"       $icon="power-16px"        $value="" $unit="W"   />
          <InfoRow name="sensorTemperature" $icon="temperature-16px"  $value="" $unit="°C"  />
          <InfoRow name="sensorFan"         $icon="fan-16px"          $value="" $unit="RPM" />
          <InfoRow name="sensorHumidity"    $icon="humidity-16px"     $value="" $unit="%"   />
      </container>

    </container>

  </root>

</gui>
