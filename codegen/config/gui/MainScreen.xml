<gui>

  <resources>
    <image name="power16"       path="icons/power.png"       format="RGB565A8" />
    <image name="fan16"         path="icons/fan.png"         format="RGB565A8" />
    <image name="heat16"        path="icons/heat.png"        format="RGB565A8" />
    <image name="humidity16"    path="icons/humidity.png"    format="RGB565A8" />
    <image name="temperature16" path="icons/temperature.png" format="RGB565A8" />
    <image name="arrow-up"      path="icons/arrow_up.png"    format="RGB565A8" />
    <image name="arrow-down"    path="icons/arrow_down.png"  format="RGB565A8" />
  </resources>

  <components>
    <GraphComponent>
      <body layout="flex" flex-flow="row" width="100%">
        <container name="labelContainer" width="18px" height="100%" layout="flex" flex-flow="column" flex-align="center" />
        <container
          flex-grow="1" height="100%" bg-color="#0D141A" bg-opa="100%"
          border-color="#26343D" border-width="1px" border-side="full" radius="7px">
          <chart name="chart" width="100%" height="100%" />
          <label
            name="value" text="" width="content" height="content"
            text-align="right" align="top-right -4px 4px"
            bg-color="#0D141A" bg-opa="80%" radius="3px" />
        </container>
      </body>
    </GraphComponent>

    <InfoTile $icon $value>
      <body layout="flex" flex-flow="row" flex-align="center center center" pad-gap="3px">
        <image name="icon" src=$icon width="16px" height="16px" opa="65%" />
        <label name="value" text=$value text-align="left" />
      </body>
    </InfoTile>
  </components>

  <root bg-color="#070B0E" text-color="#FFFFFF">
    <container
      name="wrapper" layout="flex" flex-flow="row"
      width="100%" height="220px"
      pad-left="6px" pad-right="6px" pad-top="5px" pad-bottom="4px" pad-gap="6px">

      <container name="chartsPanel" layout="flex" flex-flow="column" width="194px" height="100%" pad-gap="4px">
        <container name="chartsHeader" width="100%" height="20px" layout="flex" flex-flow="row" flex-align="center center center">
          <label name="trendsTitle" text="TRENDS" flex-grow="1" text-color="#AAB8C0" />
          <label name="windowLabel" text="1 MIN" text-color="#8AB4F4" />
        </container>

        <GraphComponent name="tempGraph" width="100%" height="98px" />
        <GraphComponent name="powerGraph" width="100%" height="66px" />

        <container name="timeAxis" width="100%" flex-grow="1" layout="flex" flex-flow="row" flex-align="space-around center center" pad-left="18px">
          <label name="t4" width="20%" text-align="center" text-color="#60717B" text="60s" />
          <label name="t3" width="20%" text-align="center" text-color="#60717B" text="45s" />
          <label name="t2" width="20%" text-align="center" text-color="#60717B" text="30s" />
          <label name="t1" width="20%" text-align="center" text-color="#60717B" text="15s" />
          <label name="t0" width="20%" text-align="center" text-color="#8A9AA4" text="NOW" />
        </container>
      </container>

      <container name="controlPanel" layout="flex" flex-flow="column" flex-grow="1" height="100%" pad-gap="4px">
        <container
          name="systemStateBg" width="100%" height="24px"
          bg-color="#7BBF56" bg-opa="100%" radius="8px">
          <label name="systemState" align="center" text="READY" text-color="#071008" />
        </container>

        <container name="controlHeader" width="100%" height="14px" layout="flex" flex-flow="row" flex-align="space-between center center">
          <label name="controlsTitle" text="MENU" text-color="#778791" />
          <label name="modeLabel" text="BROWSE" text-color="#8AB4F4" />
        </container>

        <container name="menuContainer" width="100%" flex-grow="1" layout="flex" flex-flow="column" flex-align="center">
          <image src="arrow-up" name="menuArrUp" opa="50%" />
          <container name="menuRows" width="100%" height="content" />
          <image src="arrow-down" name="menuArrDown" opa="50%" />
        </container>

        <container
          name="infoTiles" width="100%" height="40px"
          layout="flex" flex-flow="row-wrap" flex-align="space-around space-around space-around"
          bg-color="#0D141A" bg-opa="100%" radius="6px" pad="2px">
          <InfoTile name="fanInfo"   $icon="fan16"         $value="OFF"   width="50%" height="50%" />
          <InfoTile name="humidInfo" $icon="humidity16"    $value="--%"   width="50%" height="50%" />
          <InfoTile name="powerInfo" $icon="power16"       $value="0.0W"  width="50%" height="50%" />
          <InfoTile name="deltaInfo" $icon="temperature16" $value="--.-°" width="50%" height="50%" />
        </container>
      </container>
    </container>

    <container name="footer" width="100%" height="20px">
      <label name="pressHint" text="PRESS: EDIT/OPEN" />
      <label name="holdHint" text="HOLD: HOME" />
    </container>
  </root>
</gui>
