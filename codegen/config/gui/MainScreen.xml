<gui>

  <resources>

      <!-- fonts are not implemented yet -->
    <font name="my-very-special-font" />

    <image name="power16"       path="icons/power.png"        format="RGB565A8" resize="16x16" /> <!-- resize not supported yet -->
    <image name="fan16"         path="icons/fan.png"          format="RGB565A8" resize="16x16" /> <!-- resize not supported yet -->
    <image name="heat16"        path="icons/heat.png"         format="RGB565A8" resize="16x16" /> <!-- resize not supported yet -->
    <image name="humidity16"    path="icons/humidity.png"     format="RGB565A8" resize="16x16" /> <!-- resize not supported yet -->
    <image name="temperature16" path="icons/temperature.png"  format="RGB565A8" resize="16x16" /> <!-- resize not supported yet -->
    <image name="arrow-up"      path="icons/arrow_up.png"     format="RGB565A8" />
    <image name="arrow-down"    path="icons/arrow_down.png"   format="RGB565A8" />

  </resources>

  <components>

    <!-- GRAPH COMPONENT -->
    <GraphComponent $label $color>
      <body layout="flex" flex-flow="row">
        <container name="labelContainer" width="22px" height="100%" layout="flex" flex-flow="column" flex-align="center">
          <!-- Rotate label will be inserted in cpp -->
        </container>
        <container flex-grow="1" height="100%" border-color="#fff" border-width="1px" border-side="full" radius="8px">
          <container name="grid" width="100%" height="100%"></container>
          <chart name="chart" width="100%" height="100%" />
        </container>
      </body>
    </GraphComponent>

    <!-- SETTINGS ROW COMPONENT -->
    <MenuRow $label $value>
      <body layout="flex" flex-flow="row" width="100%" height="content">
        <label name="label" text=$label text-align="left" flex-grow="1" height="content"/>
        <label name="value" text=$value text-align="right" width="content" height="content" />
      </body>
    </MenuRow>

    <!-- INFO ROW COMPONENT -->
    <InfoTile $icon $value>
      <body layout="flex" flex-flow="column" flex-align="center" margin="0 0 4px 4px">
        <image name="icon" src=$icon width="16" height="16" />
        <label name="value" text=$value />
      </body>
    </InfoTile>

  </components>

  <root bg-color="#000000" text-color="#ffffff">

    <!-- Wrapper -->
    <container name="wrapper" layout="flex" flex-flow="row" width="100%" height="100%">

      <!-- Left side of screen (Graphs) -->
      <container layout="flex" flex-flow="column" width="208px" height="100%">

        <GraphComponent name="tempGraph"  width="100%" height="126px" pad-top="8px" pad-bottom="4px" />

        <GraphComponent name="powerGraph" width="100%" height="92px" pad-top="4px" />

        <container width="100%" flex-grow="1" layout="flex" flex-flow="row" flex-align="space-around center center" pad-left="22px" >
          <label name="t4" width="20%" text-align="center" text-color="rgb(166, 166, 166)" text="12h" pad-left="1px" /> <!-- 1px padding to compensate border of graph -->
          <label name="t3" width="20%" text-align="center" text-color="rgb(166, 166, 166)" text="9h" />
          <label name="t2" width="20%" text-align="center" text-color="rgb(166, 166, 166)" text="6h" />
          <label name="t1" width="20%" text-align="center" text-color="rgb(166, 166, 166)" text="3h" />
          <label name="t0" width="20%" text-align="center" text-color="rgb(166, 166, 166)" text="now" pad-right="1px" /> <!-- 1px padding to compensate border of graph -->
        </container>

      </container>

      <!-- Right side of screen (SystemState, Menu, InfoTiles) -->
      <container layout="flex" flex-flow="column" flex-grow="1" height="100%" pad="8px 8px 8px 0px">

        <!-- Status box -->
        <container name="system-state-bg" width="100%" height="22px" bg-color="#70bc47" bg-opa="100%" radius="8px">
          <label name="system-state" align="center" text="Regulating" text-color="#000" />
        </container>

        <!-- Menu -->
        <container 
          width="100%" flex-grow="1" pad-top="8px"
          layout="flex" flex-flow="column" flex-align="center">
           
          <!-- arrow up + horizontal line -->
          <image src="arrow-up" name="menuArrUp" opa="40%" />
          <container width="100%" height="4px" />

          <!-- Menu Rows Container -->
          <container 
            width="100%" flex-grow="1" border-color="#fff" border-width="1px" border-side="top bottom"
            layout="flex" flex-flow="column" flex-align ="space-evenly center center">

            <!-- Menu Rows -->
            <MenuRow $label="Power" $value="On" />
            <MenuRow $label="Target" $value="32.5°C" />
            <MenuRow $label="History" $value="12h" />
            <MenuRow $label="Fan" $value="Auto" />
            <MenuRow $label="Calib" $value="-->" />

          </container>

          <!-- horizontal line + arrow down -->
          <container width="100%" height="4px" />
          <image src="arrow-down" name="menuArrDown" />

        </container>

        <!-- Info Tiles -->
        <container width="100%" height="content" layout="flex" flex-flow="row-wrap" flex-align="center space-around space-around" pad-top="4px" pad-bottom="4px">
          <InfoTile opa="75%" name="fanInfo"   $icon="fan16"      $value="0%"    width="50%" height="content" />
          <InfoTile opa="75%" name="humidInfo" $icon="humidity16" $value="0.0%"  width="50%" height="content" />
          <InfoTile opa="75%" name="powerInfo" $icon="power16"    $value="0.0W"  width="50%" height="content" />
          <InfoTile opa="75%" name="timeInfo"  $icon="heat16"     $value="1d 5h" width="50%" height="content" />
        </container>

      </container>

    <!-- End Wrapper -->
    </container>

  </root>

</gui>
