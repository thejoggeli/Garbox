<gui>

  <resources>

      <!-- fonts are not implemented yet -->
    <font name="my-very-special-font" />

    <image name="power-16px"       path="icons/power.png"        resize="16x16" format="RGB565A8" />
    <image name="fan-16px"         path="icons/fan.png"          resize="16x16" format="RGB565A8" />
    <image name="heat-16px"        path="icons/heat.png"         resize="16x16" format="RGB565A8" />
    <image name="humidity-16px"    path="icons/humidity.png"     resize="16x16" format="RGB565A8" />
    <image name="temperature-16px" path="icons/temperature.png"  resize="16x16" format="RGB565A8" />
    <image name="rpm-16px"         path="icons/rpm.png"          resize="16x16" format="RGB565A8" />

  </resources>

  <components>

    <!-- SETTINGS ROW COMPONENT -->
    <!-- Row layout: Label | (hidden left arrow) | Value | (hidden right arrow) -->
    <!-- Always hidden arrows; user can choose to show them later in C++ -->
    <SettingRow $label $value>
      <body layout="flex" flex-flow="row" width="content" height="content">
        <label name="label" text=$label text-align="left"   width="content" />
        <label name="value" text=$value text-align="center" width="content" />
      </body>
    </SettingRow>

    <!-- INFO ROW COMPONENT -->
    <!-- Row layout: Icon | Value | Unit -->
    <!-- Evenly distributed vertically by parent container -->
    <InfoRowUnitText $icon $value $unit="unit" $hideUnit="false" >
      <body layout="flex" flex-flow="row" height="content" width="100%">
        <image name="icon"  src=$icon width="16" height="16" />
        <label name="value" text=$value pad-left="4px" pad-right="4px" />
        <label name="unit"  text=$unit hidden=$hideUnit text-align="right" flex-grow="1" />
      </body>
    </InfoRowUnitText>

    <!-- INFO ROW COMPONENT -->
    <!-- Row layout: Icon | Value | Unit -->
    <!-- Evenly distributed vertically by parent container -->
    <InfoRowUnitIcon $icon $value $unitIcon $hideUnit="false" >
      <body layout="flex" flex-flow="row" height="content" width="100%">
        <image name="icon"  src=$icon width="16" height="16" />
        <label name="value" text=$value pad-left="4px" pad-right="4px" flex-grow="1" />
        <image name="unit" src=$unitIcon hidden=$hideUnit width="16" height="16" />
      </body>
    </InfoRowUnitIcon>

  </components>

  <root bg-color="#000000" text-color="#ffffff">

    <container 
      layout="flex" flex-flow="row" width="100%" height="100%"
      border-color="#ffffff" border-width="1px" border-side="full"
    >

      <container layout="flex" flex-flow="column" flex-align="start start start" flex-grow="1" height="100%" pad="4px" pad-gap="4px">
        <SettingRow name="settingPower"       $label="Power"      bg-color="#880088" bg-opa="100%" $value="On" />
        <SettingRow name="settingTarget"      $label="Target"     bg-color="#008888" bg-opa="100%" $value="30.0°C" />
        <SettingRow name="settingFan"         $label="Fan"        bg-color="#880000" bg-opa="100%" $value="auto" />
        <SettingRow name="settingHeater"      $label="Heater"     bg-color="#000088" bg-opa="100%" $value="auto" />
        <SettingRow name="settingBrightness"  $label="Brightness" bg-color="#008800" bg-opa="100%" $value="-" />
        <SettingRow name="settingCalibrate"   $label="Calibrate"  bg-color="#888800" bg-opa="100%" $value="-" />
        <SettingRow name="settingAdvanced"    $label="Advanced"   bg-color="#880088" bg-opa="100%" $value="-" />
      </container>

      <container 
        layout="flex" flex-flow="column" flex-align="start center center" 
        width="92px" height="100%" pad="4px" pad-gap="8px"
        border-color="#ffffff" border-width="1px" border-side="left right" border-opa="100%"  
      >
        <label text="Setpoint" text-align="center" />
        <InfoRowUnitText name="statusEngine"      $icon="power-16px"        $value="" $hideUnit="true" />
        <InfoRowUnitText name="statusTemperature" $icon="temperature-16px"  $value="" $unit="°C" />
        <InfoRowUnitText name="statusHeat"        $icon="heat-16px"         $value="" $unit="%" />
        <InfoRowUnitText name="statusFan"         $icon="fan-16px"          $value="" $unit="%" />
      </container>

      <container layout="flex" flex-flow="column" flex-align="start center center" width="90px" height="100%" pad="4px" pad-gap="8px">
        <label text="Sensors" text-align="center" />
        <InfoRowUnitText name="sensorPower"       $icon="power-16px"        $value="" $unit="W"  />
        <InfoRowUnitText name="sensorTemperature" $icon="temperature-16px"  $value="" $unit="°C" />
        <InfoRowUnitText name="sensorHumidity"    $icon="humidity-16px"     $value="" $unit="%" />
        <InfoRowUnitIcon name="sensorFan"         $icon="fan-16px"          $value="" $unitIcon="rpm-16px" />
      </container>

    </container>

  </root>

</gui>
