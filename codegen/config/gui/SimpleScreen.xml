<gui>

  <resources>
    <image name="power16"      path="icons/power.png"      format="RGB565A8" />
    <image name="fan16"        path="icons/fan.png"        format="RGB565A8" />
    <image name="heat16"       path="icons/heat.png"       format="RGB565A8" />
    <image name="humidity16"   path="icons/humidity.png"   format="RGB565A8" />
  </resources>

  <components>
    <MetricCard $icon $label $value>
      <body
        layout="flex" flex-flow="row" flex-align="center center center"
        width="100%" flex-grow="1"
        pad-left="7px" pad-right="7px" pad-top="2px" pad-bottom="2px" pad-gap="7px"
        bg-color="#111A21" bg-opa="100%" radius="7px"
        border-color="#26343D" border-width="1px" border-side="full">
        <image name="icon" src=$icon width="16px" height="16px" opa="75%" />
        <container layout="flex" flex-flow="column" flex-grow="1" height="content" pad-gap="0px">
          <label name="label" text=$label text-color="#778791" />
          <label name="value" text=$value text-color="#FFFFFF" />
        </container>
      </body>
    </MetricCard>
  </components>

  <root bg-color="#070B0E" text-color="#FFFFFF">
    <container
      name="wrapper" layout="flex" flex-flow="column"
      width="100%" height="220px"
      pad-left="8px" pad-right="8px" pad-top="7px" pad-bottom="5px" pad-gap="6px">

      <container name="header" width="100%" height="25px" layout="flex" flex-flow="row" flex-align="center center center">
        <container
          name="statusPill" width="100%" height="25px"
          layout="flex" flex-flow="row" flex-align="center center center" pad-gap="5px"
          bg-color="#16241B" bg-opa="100%" radius="12px">
          <image name="statusIcon" src="power16" width="16px" height="16px" />
          <label name="statusText" text="CONTROL OFF" />
        </container>
      </container>

      <container name="content" width="100%" flex-grow="1" layout="flex" flex-flow="row" pad-gap="7px">
        <container
          name="gaugePanel" width="194px" height="100%"
          bg-color="#0D141A" bg-opa="100%" radius="12px"
          border-color="#26343D" border-width="1px" border-side="full">
          <container align="center" name="arcContainer" width="158px" height="158px">
            <arc name="arcBg"
              align="center" width="158px" height="158px"
              arc-bg-width="13px" arc-bg-angles="0 359" arc-bg-color="#263138"
              arc-opa="0%" arc-bg-opa="100%" arc-bg-rounded="1" />
            <arc name="arcMeasured"
              align="center" width="158px" height="158px"
              arc-width="13px" arc-angles="0 60" arc-color="#8AB4F4"
              arc-opa="100%" arc-bg-opa="0%" arc-rounded="1" />
            <arc name="arcTarget"
              align="center" width="136px" height="136px"
              arc-width="4px" arc-angles="0 120" arc-color="#E3C567"
              arc-opa="100%" arc-bg-opa="0%" arc-rounded="1" />
          </container>
          <container align="center" layout="flex" flex-flow="column" flex-align="center" width="120px">
            <label name="measuredLabel" text="CHAMBER" text-color="#778791" />
            <container layout="flex" flex-flow="row" flex-align="center end end" width="content" height="content">
              <label name="measuredValue" text="--.-" />
              <label name="measuredUnit" text="°C" pad-bottom="4px" />
            </container>
            <label name="temperatureDelta" text="waiting for sensor" text-color="#60717B" />
          </container>
        </container>

        <container name="sidePanel" flex-grow="1" height="100%" layout="flex" flex-flow="column" pad-gap="5px">
          <container
            name="targetCard" width="100%" height="68px"
            layout="flex" flex-flow="column" flex-align="center center center"
            bg-color="#13202B" bg-opa="100%" radius="9px"
            border-color="#8AB4F4" border-width="1px" border-side="full">
            <label name="targetLabel" text="TARGET" text-color="#8AB4F4" />
            <container layout="flex" flex-flow="row" flex-align="center center center" width="100%" height="content" pad-left="5px" pad-right="5px">
              <label name="targetRotateLeft" width="12px" text-align="center" text="" />
              <container flex-grow="1" height="content" layout="flex" flex-flow="row" flex-align="center end end" pad-gap="3px">
                <label name="targetValue" text="32.0" />
                <label name="targetUnit" text="°C" pad-bottom="2px" />
              </container>
              <label name="targetRotateRight" width="12px" text-align="center" text="" />
            </container>
          </container>

          <MetricCard name="humidity" $icon="humidity16" $label="HUMIDITY" $value="--.-%" />
          <MetricCard name="heater" $icon="heat16" $label="HEATER" $value="0%" />
          <MetricCard name="fan" $icon="fan16" $label="FAN" $value="OFF" />
        </container>
      </container>

    </container>

    <container name="footer" width="100%" height="20px">
      <label name="pressHint" text="PRESS: START/STOP" />
      <label name="holdHint" text="HOLD: MENU" />
    </container>
  </root>
</gui>
